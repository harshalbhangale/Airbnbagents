{
  "name": "@agentbnb/desktop",
  "productName": "agentbnb",
  "version": "0.1.0",
  "private": true,
  "description": "Rent narrow, permission-controlled capabilities of your own signed-in sessions to AI agents.",
  "author": "agentbnb",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron dist/main.mjs",
    "dist": "node build.mjs && electron-builder --publish never",
    "dist:dir": "node build.mjs && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@agentbnb/demo-site": "workspace:*",
    "@agentbnb/protocol": "workspace:*",
    "@agentbnb/sdk": "workspace:*",
    "@agentbnb/server": "workspace:*",
    "@agentbnb/worker": "workspace:*",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.0",
    "playwright": "1.63.0",
    "viem": "^2.21.0"
  },
  "build": {
    "appId": "app.agentbnb.host",
    "productName": "agentbnb",
    "electronVersion": "45.4.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "executableName": "agentbnb"
    },
    "artifactName": "agentbnb-${version}-${os}-${arch}.${ext}"
  }
}
